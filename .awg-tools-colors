########################
### Цвета и символы: ###
########################
#┌───────┬────────────────┬─────────────────┐┌───────┬─────────────────┬───────┐
#│ Fg/Bg │ Color          │ Octal           ││ Code  │ Style           │ Octal │
#├───────┼────────────────┼─────────────────┤├───────┼─────────────────┼───────┤
#│  K/k  │ Black          │ \e[ + 3/4  + 0m ││  s/S  │ Bold (strong)   │ \e[1m │
#│  R/r  │ Red            │ \e[ + 3/4  + 1m ││  d/D  │ Dim             │ \e[2m │
#│  G/g  │ Green          │ \e[ + 3/4  + 2m ││  i/I  │ Italic          │ \e[3m │
#│  Y/y  │ Yellow         │ \e[ + 3/4  + 3m ││  u/U  │ Underline       │ \e[4m │
#│  B/b  │ Blue           │ \e[ + 3/4  + 4m ││  f/F  │ Blink (flash)   │ \e[5m │
#│  M/m  │ Magenta        │ \e[ + 3/4  + 5m ││  n/N  │ Negative        │ \e[7m │
#│  C/c  │ Cyan           │ \e[ + 3/4  + 6m ││  h/H  │ Hidden          │ \e[8m │
#│  W/w  │ White          │ \e[ + 3/4  + 7m ││  t/T  │ Strikethrough   │ \e[9m │
#├───────┴────────────────┼─────────────────┤├───────┼─────────────────┼───────┤
#│  High intensity        │ \e[ + 9/10 + *m ││   0   │ Reset           │ \e[0m │
#└────────────────────────┴─────────────────┘└───────┴─────────────────┴───────┘
#                                             Uppercase = Reset a style: \e[2*m
################################################################################
_c() { [ $# == 0 ] && printf "\e[0m" || printf "$1" | sed 's/\(.\)/\1;/g;s/\([SDIUFNHT]\)/2\1/g;s/\([KRGYBMCW]\)/3\1/g;s/\([krgybmcw]\)/4\1/g;y/SDIUFNHTsdiufnhtKRGYBMCWkrgybmcw/12345789123457890123456701234567/;s/^\(.*\);$/\\e[\1m/g'; }

nc=$(echo -e $(_c 0)); bld=$(echo -e $(_c s)); sma=$(echo -e $(_c d)); und=$(echo -e $(_c u)); strt=$(echo -e $(_c t));
bnc=$(echo -e $(_c 0)$(_c s));

if tty >/dev/null 2>&-; then
    blk=$(_c K); red=$(_c R); grn=$(_c G); yel=$(_c Y); blu=$(_c Bkh); mag=$(_c Mkh); cy=$(_c Ckh); wh=$(_c Wkh);
    blkb=$(_c Wk); redb=$(_c Wrs); grnb=$(_c Gfn); yelb=$(_c Byf); blub=$(_c Wbs); magb=$(_c sWm); cyb=$(_c Cfn); whb=$(_c Kwf);
    bblk=$(_c Ks); bred=$(_c Rs); bgrn=$(_c Gs); byel=$(_c sY); bblu=$(_c Bks); bmag=$(echo -e $(_c sM)); bcy=$(_c Cks); bwh=$(_c Wks);
    rev=$(tput rev); blink=$(_c f); neg=$(_c n);
    sym_ok=$(printf "${grn}%s${nc}" ✅); sym_err=$(printf "${red}%s${nc}" ❌); install=$(printf "${bnc}%s${nc}" 💿);
    sym_info=$(printf "${bblu}%s${nc}" 📋);sym_warn=$(printf "${byel}%s${nc}" "⚠⚠"); sym_dbg=$(printf "${bwh}%s${nc}" 🔧); sym_star=$(echo -en "${byel}✨${nc}");
else
    neg=''; blink=''; rev='';
    blk=''; red=''; grn=''; yel=''; blu=''; mag=''; cy=''; wh='';
    blkb=''; redb=''; grnb=''; yelb=''; blub=''; magb=''; cyb=''; whb='';
    bblk=''; bred=''; bgrn=''; byel=''; bblu=''; bmag=''; bcy=''; bwh='';
    sym_ok='✅'; sym_err='❌'; install='💿'; sym_info='📋'; sym_warn='⚠⚠'; sym_dbg='🔧'; sym_star='✨';
fi
