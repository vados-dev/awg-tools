log_msg() {
    local type="$1";local msg="$2";
    local ts=$(date '+%b %d %T');
    local entry="[$ts] $type: $msg";
    case "$type" in
        Инфо)  printstr "${bblue}$type: ${bnc}$msg" "$sym_info" ;;
        Ok)    printstr "${bgrn}$type: ${bnc}$msg" "$sym_ok" ;;
        Зацени)  printstr "${byel}$type: ${bnc}$msg" "$sym_warn" ;;
        Ошибка) printstr "${bred}$type: ${bnc}$msg" "$sym_err" >&2 ;;
        Отладка) printstr "${bwh}$type: ${bnc}$msg" "$sym_dbg" >&2 ;;
        *) app_title "Error" "$sym_err" ;;
    esac

    if [[ "${DEFAULT_LOG}" != "" ]] && [[ "${SAVE_LOG}" == true ]];then
        local log="${DEFAULT_LOG}";
        if ! mkdir -p "$(dirname "${log}")" || ! echo ${entry} >> "${log}"; then
            printstr "Ошибка записи лога '${log}'. ${bred}ERROR:${nc} " "$entry" "$sym_err";
            exit 1;
        fi
    fi
}

