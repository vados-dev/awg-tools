function _ping {
if [[ "$1" != "" ]];then
    url="$1";
    index=1;
    ! command -v grep "http" | echo "$url" >/dev/null 2>&1; hostname="${url}" || hostname=$(echo "$url" | awk -F/ '{print $3}')
    rtt=$(ping -c 1 -W 1 "$hostname" 2>/dev/null | grep 'time=' | awk -F'time=' '{print $2}' | awk '{print $1}');
    rtt=${rtt//.*/};
    printf " [%i]                  %sms %s\n" "$index" "$rtt" "$url";
else
    echo "Нужен адрес!"
fi
}
