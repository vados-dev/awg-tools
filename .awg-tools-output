die()       { log_error "Сдохла: $1"; [[ "${DEFAULT_LOG}" != ""  ]] && ${SAVE_LOG}; log_error "Лог: $DEFAULT_LOG" && exit 1 || exit 1; }

print_info()    { log "$1"; }
print_ok()      { log_ok "$1"; }
