
#SELF="$(readlink -f "${BASH_SOURCE[0]}")"
cur_dir=${SELF%/*}
dir_name=${cur_dir##*/}
ME_ROOT=${cur_dir};
dir_name="${PWD##*/}";
script_name_ext="${0##*/}";
script_name="${script_name_ext%.*}";
app_file=${script_name_ext};
app_name=${1:-$script_name};
pr_name=${2:-$app_name};
version="0.0.1"

# Log
SAVE_LOG=true
DEFAULT_LOG="$ME_ROOT/logs/$app_name.log"

# For colors
COLS_NUM=78
NO_COLOR=false;

CONF_DIR="/etc/amnezia/amneziawg/"
DEF_NAME="awg2vds"
DEF_CONF=${CONF_DIR}${1:-$DEF_NAME}.conf;
ENDPOINT="146.120.64.211"
ENDPOINT_PORT="51820"
ALLOWED_IPS="0.0.0.0/0"
